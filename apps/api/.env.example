# Alle Variablen sind optional; die Werte unten sind die Standardwerte.
SMARTCRAFT_ENVIRONMENT=development
# Nur "mock" erlaubt, bis ein echter KI-Provider freigegeben ist.
SMARTCRAFT_AI_PROVIDER=mock
SMARTCRAFT_CORS_ORIGINS=["http://localhost:5173"]
SMARTCRAFT_DATABASE_URL=sqlite:///./smartcraft.db
SMARTCRAFT_STORAGE_DIR=./storage
SMARTCRAFT_MAX_UPLOAD_MB=15
SMARTCRAFT_MAX_IMAGE_MEGAPIXELS=50
SMARTCRAFT_MAX_IMAGE_EDGE=1600
# false = flüchtiger Speicher (Demo), Oberfläche zeigt Hinweis
SMARTCRAFT_PERSISTENT_STORAGE=true
# Härtung (siehe docs/07-betrieb-und-fehler.md)
SMARTCRAFT_RATE_ANALYSES_PER_MINUTE=10
SMARTCRAFT_RATE_ANALYSES_PER_DAY=200
SMARTCRAFT_MAX_ANALYSES_PER_DAY=500
SMARTCRAFT_RATE_WRITES_PER_MINUTE=120
SMARTCRAFT_AI_TIMEOUT_SECONDS=25
