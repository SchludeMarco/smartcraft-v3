# Alle Variablen sind optional; die Werte unten sind die Standardwerte.
SMARTCRAFT_ENVIRONMENT=development
# Nur "mock" erlaubt, bis ein echter KI-Provider freigegeben ist.
SMARTCRAFT_AI_PROVIDER=mock
SMARTCRAFT_CORS_ORIGINS=["http://localhost:5173"]
SMARTCRAFT_DATABASE_URL=sqlite:///./smartcraft.db
